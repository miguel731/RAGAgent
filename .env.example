# ── LLM Provider ────────────────────────────────────────────────────────────
# Opciones: cohere | openai | anthropic | ollama
LLM_PROVIDER=cohere

# ── Embedding Provider ───────────────────────────────────────────────────────
# Opciones: cohere | openai | ollama
# Si no se define, usa el mismo valor que LLM_PROVIDER (cuando es compatible)
# NOTA: cambiar este valor re-indexará el PDF automáticamente al arrancar
EMBEDDING_PROVIDER=cohere

# ── Cohere ───────────────────────────────────────────────────────────────────
COHERE_API_KEY=your_cohere_api_key_here
COHERE_MODEL=command-r-plus-08-2024
COHERE_EMBEDDING_MODEL=embed-multilingual-v3.0

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Anthropic (solo LLM — no tiene modelos de embeddings propios) ────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ── Ollama (local, sin API key) ──────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
